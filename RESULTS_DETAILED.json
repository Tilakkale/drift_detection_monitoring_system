      "your_value": 0.8746,
      "interpretation": "87.46% of all samples classified correctly"
    },
    "precision": {
      "definition": "When model predicts 'anomaly' - how often is it correct?",
      "formula": "TP / (TP + FP)",
      "your_value": 1.0,
      "interpretation": "100% of predicted anomalies are real (zero false positives)",
      "meaning": "✅ No false alarms - users trust the alerts"
    },
    "recall": {
      "definition": "What percentage of actual anomalies does the model catch?",
      "formula": "TP / (TP + FN)",
      "your_value": 1.0,
      "interpretation": "100% of real anomalies are detected (zero missed anomalies)",
      "meaning": "✅ No anomalies slip through - complete coverage"
    },
    "f1_score": {
      "definition": "Harmonic mean of precision and recall (0-1 scale)",
      "formula": "2 × (Precision × Recall) / (Precision + Recall)",
